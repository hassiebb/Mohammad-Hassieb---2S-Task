# ==============================================================================
# Odoo Sales Mobile — Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTE:
# Variables prefixed with 'EXPO_PUBLIC_' are inlined directly into the mobile
# JavaScript bundle at build time. They are visible to anyone inspecting or
# decompiling the application package. NEVER place secrets, private passwords,
# administrative tokens, or private signing keys in this file or any .env file.
# ==============================================================================

# Service Mode: 'odoo' for live ERP connection
EXPO_PUBLIC_SERVICE_MODE=odoo

# Odoo ERP Server Base URL
# Example: https://my-company.odoo.com or http://192.168.1.50:8069
# Note: Trailing slashes and common web path suffixes (/odoo, /web) are sanitized automatically.
EXPO_PUBLIC_ODOO_URL=https://your-odoo-instance.odoo.com

# Target Odoo Database Name
# The PostgreSQL database name configured on your Odoo instance.
EXPO_PUBLIC_ODOO_DB=your-database-name

# Transport Protocol Selection: 'jsonrpc' (default) or 'xmlrpc'
# - 'jsonrpc': Uses Odoo web-client JSON-RPC 2.0 endpoints (/web/session/authenticate, /web/dataset/call_kw).
# - 'xmlrpc':  Uses standard Odoo external API endpoints (/xmlrpc/2/common, /xmlrpc/2/object).
EXPO_PUBLIC_ODOO_TRANSPORT=jsonrpc
